# ─────────────────────────────────────────────────────────────────────────────
# PDFGodWork — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# The GCS bucket where uploaded and processed files are stored.
GCS_BUCKET_NAME=pdfgodwork-files

# Your GCP project ID (e.g. my-project-123456)
GCS_PROJECT_ID=your-gcp-project-id

# Path to your service-account JSON key file (LOCAL DEV ONLY).
# In Cloud Run / production, leave this empty and use Workload Identity or ADC.
GCS_KEY_FILE_PATH=/path/to/service-account-key.json

# ── Database ─────────────────────────────────────────────────────────────────
# MySQL connection string. Use Google Cloud SQL (with Cloud SQL Auth Proxy)
# or any managed MySQL service (PlanetScale, Railway, etc.)
# Format: mysql://user:password@host:3306/dbname
DATABASE_URL=mysql://pdfgodwork:password@localhost:3306/pdfgodwork

# ── LLM API keys (provide the keys for models you want to use) ────────────────
# At minimum provide CURSOR_API_KEY since Composer is the default model.
# Create a key at: https://cursor.com/dashboard → Integrations / API Keys

CURSOR_API_KEY=key_...
# OpenAI-compatible base URL for Cursor chat (override if using a local proxy)
CURSOR_API_BASE_URL=https://api.cursor.com/v1

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which model is used when the user hasn't selected one.
# Options: composer-2.5, composer-2, gpt-4o-mini, claude-sonnet-4-6
DEFAULT_LLM_MODEL=composer-2.5

# ── App / Auth ────────────────────────────────────────────────────────────────
# A long random secret used to sign session JWT cookies.
# Generate with: openssl rand -base64 48
JWT_SECRET=your-long-random-secret-here

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Production: HTTPS URL for webhook (e.g. https://your-domain.com/api/bots/telegram/webhook)
# Leave empty for local dev — the bot uses long polling instead.
TELEGRAM_WEBHOOK_URL=

# Optional secret for webhook verification (set the same value in BotFather if supported)
TELEGRAM_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
